# Temporal riddle-kiosk thought exercise — shares the root project's venv
# and uv.lock; only the `just` recipes are separate.

default: list

list:
    @just --list

# Start the local Temporal dev server (separate terminal, leave running)
server:
    temporal server start-dev

# Start the worker (separate terminal, leave running)
worker:
    {{justfile_directory()}}/../.venv/bin/python worker.py

# One kid's session: mic + speakers, Ctrl-C to end, rerun for next kid.
# Pass --record to also save mic + agent audio to recordings/ (off by default).
kiosk *args:
    {{justfile_directory()}}/../.venv/bin/python kiosk_client.py {{args}}

# Force-terminate the in-progress game from a second terminal — for when the
# kiosk process itself is wedged and Ctrl-C in terminal 3 won't land. Normal
# "kid walked off" case is just Ctrl-C; this is the break-glass fallback.
kill:
    temporal workflow terminate --workflow-id "$(cat current_workflow.txt)" --reason "kiosk force-killed"
