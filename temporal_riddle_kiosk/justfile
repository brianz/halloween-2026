# Temporal riddle-kiosk thought exercise — own venv, own deps, separate
# from the root project's `just` recipes.

default: list

list:
    @just --list

# Sync Python deps from this directory's pyproject.toml into its own venv
deps:
    uv sync

# Start the local Temporal dev server (separate terminal, leave running)
server:
    temporal server start-dev

# Start the worker (separate terminal, leave running)
worker:
    .venv/bin/python worker.py

# One kid's session: mic + speakers, Ctrl-C to end, rerun for next kid
kiosk:
    .venv/bin/python kiosk_client.py
